<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gold Harvest - Organic Turmeric Powder</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #fff8e1;
      color: #3e2f00;
    }
    header {
      background-color: #f5a623;
      color: white;
      padding: 20px;
      text-align: center;
    }
    nav {
      display: flex;
      justify-content: center;
      background-color: #fff3cd;
      padding: 10px;
    }
    nav a {
      margin: 0 15px;
      color: #3e2f00;
      text-decoration: none;
      font-weight: bold;
    }
    section {
      padding: 30px;
      max-width: 1000px;
      margin: auto;
    }
    .hero {
      background-image: url('hero-image.jpg');
      background-size: cover;
      background-position: center;
      color: #ffe600;
      padding: 100px 20px;
      text-align: center;
    }
    .hero h1 {
      font-size: 3em;
      margin: 0;
      animation: fadeIn 2s ease-in-out;
      font-weight: bold;
      text-shadow: 2px 2px 4px #000000;
    }
    .logo {
      max-width: 150px;
      margin: 20px auto;
      display: block;
    }
    .product-images {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .product-images img {
      width: 200px;
      height: auto;
      border: 2px solid #f5a623;
      border-radius: 10px;
      transition: transform 0.3s ease;
    }
    .product-images img:hover {
      transform: scale(1.05);
    }
    .animate-on-scroll {
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.6s ease-out;
    }
    .animate-on-scroll.visible {
      opacity: 1;
      transform: translateY(0);
    }
    @keyframes fadeIn {
      0% { opacity: 0; transform: translateY(20px); }
      100% { opacity: 1; transform: translateY(0); }
    }
    #pincode-section input {
      padding: 10px;
      margin-right: 10px;
    }
    #pincode-section button {
      padding: 10px 20px;
      background-color: #f5a623;
      color: white;
      border: none;
      cursor: pointer;
    }
    #payment-section button {
      padding: 10px 20px;
      background-color: #3e2f00;
      color: white;
      border: none;
      cursor: pointer;
      margin-top: 20px;
    }
    #deliverability-message {
      font-weight: bold;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <header>
    <img src="gold-harvest-logo.png" alt="Gold Harvest Logo" class="logo" />
    <h1>Gold Harvest</h1>
    <p>Pure Organic Turmeric Powder - Turmerica</p>
  </header>

  <nav>
    <a href="#about">About</a>
    <a href="#product">Product</a>
    <a href="#why">Why Choose Us</a>
    <a href="#contact">Contact</a>
  </nav>

  <section class="hero animate-on-scroll">
    <h1>Welcome to Gold Harvest</h1>
    <p>Bringing the golden health of nature to your home.</p>
  </section>

  <section id="about" class="animate-on-scroll">
    <h2>About Us</h2>
    <p>Gold Harvest is a brand dedicated to delivering high-quality, organic turmeric powder straight from the farms. Our product, Turmerica, is harvested using sustainable and chemical-free practices to ensure purity and maximum health benefits.</p>
  </section>

  <section id="product" class="animate-on-scroll">
    <h2>Our Product - Turmerica</h2>
    <p>Turmerica is rich in curcumin, offering exceptional color, aroma, and healing properties. Available in 100g, 250g, and 500g eco-friendly packs for your kitchen and wellness needs.</p>
    <div class="product-images">
      <img src="product-100g.png" alt="100g Pack">
      <img src="product-250g.png" alt="250g Pack">
      <img src="product-500g.png" alt="500g Pack">
    </div>
  </section>

  <section id="pincode-section" class="animate-on-scroll">
    <h2>Check Delivery Availability</h2>
    <input type="text" id="pincode" placeholder="Enter your pincode">
    <button onclick="checkPincode()">Check</button>
    <div id="deliverability-message"></div>
  </section>

  <section id="payment-section" class="animate-on-scroll">
    <h2>Ready to Order?</h2>
    <button onclick="window.location.href='payment.html'">Proceed to Payment</button>
  </section>

  <section id="why" class="animate-on-scroll">
    <h2>Why Choose Us</h2>
    <ul>
      <li>100% Certified Organic</li>
      <li>No Preservatives or Additives</li>
      <li>High Curcumin Content</li>
      <li>Support Local Farmers</li>
      <li>Environmentally Friendly Packaging</li>
    </ul>
  </section>

  <section id="contact" class="animate-on-scroll">
    <h2>Contact Us</h2>
    <p>Phone: 6289576040</p>
    <p>Email: nasrinselina66@gmail.com</p>
    <p>Instagram: <a href="https://www.instagram.com/selina.nasrin.5059?igsh=MTF2YWV2djdkbnZydA==" target="_blank">@selina.nasrin.5059</a></p>
  </section>

  <footer>
    <p>&copy; 2025 Gold Harvest. All rights reserved.</p>
  </footer>

  <script>
    function checkPincode() {
      const pin = document.getElementById("pincode").value;
      const message = document.getElementById("deliverability-message");
      if (/^\d{6}$/.test(pin)) {
        message.textContent = "Deliverable";
        message.style.color = "green";
      } else {
        message.textContent = "Invalid Pincode";
        message.style.color = "red";
      }
    }

    const scrollElements = document.querySelectorAll(".animate-on-scroll");

    const scrollObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
        } else {
          entry.target.classList.remove("visible");
        }
      });
    }, { threshold: 0.1 });

    scrollElements.forEach(el => scrollObserver.observe(el));
  </script>
</body>
</html>
